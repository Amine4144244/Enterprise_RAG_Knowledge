# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Copy this file to '.env' and fill in your real NVIDIA API key.
# Never commit your real secret keys to public git repositories!
# ==============================================================================

# Your NVIDIA API key (starts with nvapi-...)
# You can get a free key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Base URL for NVIDIA's Cloud Endpoints (OpenAI-compatible)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# The NVIDIA model names we want to use
# 1. Embedding Model: converts our text into dense numerical vectors
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# 2. Reranker Model: scores and re-orders the best chunks using deep cross-attention
NVIDIA_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# 3. LLM Model: generates the final answer with citations
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Qdrant Database Settings
# Since Qdrant runs in Docker on your local computer, the host is localhost and port is 6333
QDRANT_HOST=localhost
QDRANT_PORT=6333

# The name of our collection in Qdrant (like a table in SQL)
QDRANT_COLLECTION_NAME=enterprise_knowledge_base

# Dense vector size for nvidia/nv-embedqa-e5-v5 is 1024 dimensions
DENSE_VECTOR_SIZE=1024
